# Base de datos MySQL
DATABASE_URL="mysql://root:root@localhost:3306/bd_barberia"

# Keycloak (opcional / legacy)
KEYCLOAK_URL="http://localhost:8080"
KEYCLOAK_REALM="barberia"
KEYCLOAK_CLIENT_ID="barberia-backend"
KEYCLOAK_CLIENT_SECRET="tu-keycloak-client-secret"

# Configuración de Alertas por Correo (Nodemailer / Gmail SMTP)
SUPERADMIN_EMAIL="admin@barberia.com"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="tu-correo@gmail.com"
SMTP_PASS="tu-app-password-gmail"

# Autenticación con Google y JWT
GOOGLE_CLIENT_ID="tu-google-client-id.apps.googleusercontent.com"
JWT_SECRET="tu-clave-secreta-jwt-de-produccion"
JWT_EXPIRES_IN="7d"
FRONTEND_URL="https://barberia-frontend-production.up.railway.app"
