# Base de datos MySQL
DATABASE_URL=


# Configuración de Alertas por Correo (Nodemailer / Gmail SMTP)
SUPERADMIN_EMAIL=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=

# Autenticación con Google y JWT
GOOGLE_CLIENT_ID=
JWT_SECRET=
JWT_EXPIRES_IN=

# Secreto exclusivo de los tokens de clientes (BE retail). Debe ser distinto de
# JWT_SECRET. Si falta, la aplicación arranca, pero el login de clientes
# (POST /auth/clientes/google) y las rutas /reservas/me* fallan de forma segura
# (fail-closed), sin exponer detalles internos.
JWT_CLIENTE_SECRET=
FRONTEND_URL=

# ---------------------------------------------------------------------------
# Multitenant (negocios / barberías)
# ---------------------------------------------------------------------------
# Dominio base bajo el que se publican los subdominios de negocio.
# Con NEGOCIO_DOMINIO_BASE=barberia.com, la petición a `acme.barberia.com`
# resuelve el negocio de slug `acme`. Si se deja vacío, NO se interpreta el
# host: la resolución por subdominio queda desactivada.
NEGOCIO_DOMINIO_BASE=

# Permite resolver el negocio mediante la cabecera `X-Negocio-Slug`.
# Es la alternativa controlada para clientes móviles, emuladores y entornos sin
# subdominio. En producción, fijar a `false` si el subdominio es el mecanismo
# principal. Acepta `true`/`false` (cualquier otro valor se trata como
# habilitado).
NEGOCIO_PERMITIR_HEADER_SLUG=true

# ---------------------------------------------------------------------------
# Documentación OpenAPI (Swagger)
# ---------------------------------------------------------------------------
# Publica la documentación interactiva en /api/docs.
# - Por defecto se publica en cualquier entorno cuyo NODE_ENV no sea
#   `production`.
# - En `production` NO se publica: la documentación expone la superficie
#   completa de la API. Para publicarla de forma explícita, poner `true`.
# - `false` la desactiva en cualquier entorno.
SWAGGER_HABILITADO=

# ---------------------------------------------------------------------------
# Migración de datos al modelo multitenant (Fase 2)
# ---------------------------------------------------------------------------
# Nombre público del PRIMER negocio. Es un dato del cliente: no se inventa ni
# se deduce. Si falta, los scripts de migración fallan de forma segura.
NEGOCIO_INICIAL_NOMBRE=

# Identificador público y estable del primer negocio. Solo admite a-z, 0-9 y
# guiones (longitud máxima 63, sin empezar ni terminar en guion). Es el valor
# con el que se resolverá el negocio en la URL y en la cabecera
# `X-Negocio-Slug`.
NEGOCIO_INICIAL_SLUG=

# Zona horaria del primer negocio (por defecto America/Bogota).
NEGOCIO_INICIAL_ZONA_HORARIA=America/Bogota

# Filas por lote del backfill de `negocioId` (por defecto 1000).
NEGOCIO_BACKFILL_LOTE=1000
