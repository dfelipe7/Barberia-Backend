# Base de datos MySQL
DATABASE_URL=


# Configuración de Alertas por Correo (Nodemailer / Gmail SMTP)
SUPERADMIN_EMAIL=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=

# Autenticación con Google y JWT
GOOGLE_CLIENT_ID=
JWT_SECRET=
JWT_EXPIRES_IN=

# Secreto exclusivo de los tokens de clientes (BE retail). Debe ser distinto de
# JWT_SECRET. Si falta, la aplicación arranca, pero el login de clientes
# (POST /auth/clientes/google) y las rutas /reservas/me* fallan de forma segura
# (fail-closed), sin exponer detalles internos.
JWT_CLIENTE_SECRET=
FRONTEND_URL=
