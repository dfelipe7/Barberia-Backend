# =============================================================================
# FASE 11/15 - Variables del entorno MULTITENANT AISLADO (ejemplo).
#
# Copia este archivo a `.env.multitenant-dev` (ignorado por Git) y edita los
# valores. NO edites este archivo con credenciales reales.
#
#   Windows (PowerShell):  copy .env.multitenant-dev.example .env.multitenant-dev
#   Linux/macOS:           cp   .env.multitenant-dev.example .env.multitenant-dev
# =============================================================================

# Contrasena propia del entorno AISLADO (no es la del entorno original).
# Restriccion: solo caracteres alfanumericos (la URL de conexion se compone
# con este valor dentro del contenedor del migrador).
MYSQL_ROOT_PASSWORD=cambiaEstaContrasenaLocal123

# Base de datos del entorno multitenant aislado.
# El motor `mysql:8.0` la crea en el primer arranque del volumen.
MYSQL_DATABASE=bd_barberia_multitenant_dev

# URL de conexion para los comandos de Prisma ejecutados EN EL HOST
# (npm run db:migrate:dev / db:migrate:status:dev).
# Puerto 3308 = puerto del host del contenedor aislado.
DATABASE_URL=mysql://root:cambiaEstaContrasenaLocal123@localhost:3308/bd_barberia_multitenant_dev

# -----------------------------------------------------------------------------
# BACKEND en Docker (perfil `backend`). Se montan con `env_file`.
# -----------------------------------------------------------------------------

# Secreto de firma de los tokens de personal. En produccion: un valor aleatorio.
JWT_SECRET=cambiaEsteSecretoDeJwt

# Caducidad de los tokens de personal.
JWT_EXPIRES_IN=7d

# Secreto de los tokens de CLIENTE, DISTINTO del de personal.
JWT_CLIENTE_SECRET=cambiaEsteSecretoDeJwtDeClientes

# Identificador de cliente de Google OAuth (OBLIGATORIO: la aplicacion no
# arranca sin el).
GOOGLE_CLIENT_ID=

# Origen del frontend local (CORS).
FRONTEND_URL=http://localhost:5173

# Destinatario de las alertas de seguridad por correo.
SUPERADMIN_EMAIL=

# Permite resolver el negocio por la cabecera X-Negocio-Slug en local.
NEGOCIO_PERMITIR_HEADER_SLUG=true

# Habilita el simulador de error 500 (GET /usuarios/simular-error-grave), que
# comprueba la cadena de alertas por correo (REQ-009). Deshabilitado por
# defecto y SIEMPRE deshabilitado cuando NODE_ENV=production, aunque se
# ponga a "true". Exige, ademas, sesion de personal con rol de administracion.
SIMULADOR_ERROR_HABILITADO=false
